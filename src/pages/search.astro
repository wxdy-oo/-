---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWidgets from '../components/FloatingWidgets.astro';
import { getCollection } from 'astro:content';

// 构建搜索索引：标题 / 描述 / 标签 / 正文全文，封面用于结果卡片
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.localeCompare(a.data.date));

const index = posts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  date: p.data.date,
  tags: p.data.tags,
  views: p.data.views,
  cover: p.data.cover ?? '',
  body: (p.body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/[#>*`\-!\[\]()|]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 4000),
}));

const tagMap = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => tagMap.set(t, (tagMap.get(t) || 0) + 1)));
const hotTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([t]) => t);
---

<BaseLayout title="搜索 · 无需多言 Blog" description="在全站文章中搜索标题、描述、标签与正文。">
  <Navbar />

  <main class="container">
    <PageHeader title="搜索" subtitle="标题、描述、标签、正文，全文检索。" />

    <div class="card search-panel">
      <div class="search-box">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.4-3.4"></path>
        </svg>
        <input
          id="q"
          class="search-input"
          type="search"
          placeholder="输入关键词，试试「记忆」「Agent」「论文」…"
          aria-label="搜索关键词"
          autocomplete="off"
        />
        <button id="clearBtn" class="search-clear" type="button" aria-label="清空" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <div class="search-hot">
        <span class="hot-label">热门标签</span>
        <div class="hot-tags">
          {hotTags.map((t) => <button class="hot-tag" type="button" data-q={t}>{t}</button>)}
        </div>
      </div>
    </div>

    <p id="meta" class="search-meta" hidden></p>

    <div id="results" class="search-results"></div>

    <div id="empty" class="card search-empty" hidden>
      <svg class="empty-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-3.4-3.4"></path>
        <path d="m8.5 8.5 5 5M13.5 8.5l-5 5"></path>
      </svg>
      <h2>没有找到相关文章</h2>
      <p>换个关键词试试，或者点击上面的热门标签逛逛。</p>
    </div>

    <div id="intro" class="search-intro">
      <p>输入关键词即可实时检索全站 {posts.length} 篇文章，支持标题、描述、标签与正文匹配。</p>
    </div>
  </main>

  <Footer />
  <FloatingWidgets />
</BaseLayout>

<script is:inline define:vars={{ index, hotTags }}>
  (() => {
    const input = document.getElementById('q');
    const clearBtn = document.getElementById('clearBtn');
    const meta = document.getElementById('meta');
    const results = document.getElementById('results');
    const empty = document.getElementById('empty');
    const intro = document.getElementById('intro');

    const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const highlight = (text, words) => {
      let out = esc(text);
      words.forEach((w) => {
        if (!w) return;
        out = out.replace(new RegExp(w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), (m) => '<mark>' + m + '</mark>');
      });
      return out;
    };

    const excerptOf = (post, words) => {
      const src = post.description + ' ' + post.body;
      const lower = src.toLowerCase();
      let pos = -1;
      for (const w of words) {
        const p = lower.indexOf(w.toLowerCase());
        if (p >= 0 && (pos < 0 || p < pos)) pos = p;
      }
      if (pos < 0) return post.description;
      const start = Math.max(0, pos - 40);
      const end = Math.min(src.length, pos + 120);
      return (start > 0 ? '…' : '') + src.slice(start, end) + (end < src.length ? '…' : '');
    };

    const search = (raw) => {
      const q = raw.trim();
      clearBtn.hidden = !q;
      if (!q) {
        results.innerHTML = '';
        meta.hidden = true;
        empty.hidden = true;
        intro.hidden = false;
        return;
      }
      const words = q.split(/\s+/).filter(Boolean);
      const scored = [];
      index.forEach((p) => {
        const title = p.title.toLowerCase();
        const desc = p.description.toLowerCase();
        const tags = p.tags.join(' ').toLowerCase();
        const body = p.body.toLowerCase();
        let score = 0;
        let hit = true;
        for (const w of words) {
          const lw = w.toLowerCase();
          const inTitle = title.includes(lw);
          const inTags = tags.includes(lw);
          const inDesc = desc.includes(lw);
          const inBody = body.includes(lw);
          if (!inTitle && !inTags && !inDesc && !inBody) {
            hit = false;
            break;
          }
          if (inTitle) score += 10;
          if (inTags) score += 6;
          if (inDesc) score += 4;
          if (inBody) score += 2;
        }
        if (hit) scored.push({ p, score });
      });
      scored.sort((a, b) => b.score - a.score);

      intro.hidden = true;
      meta.hidden = false;
      meta.innerHTML = '为「<b>' + esc(q) + '</b>」找到 <b>' + scored.length + '</b> 篇文章';
      empty.hidden = scored.length > 0;

      results.innerHTML = scored
        .map(({ p }) => {
          const tags = p.tags.map((t) => '<span class="sr-tag">' + highlight(t, words) + '</span>').join('');
          const cover = p.cover
            ? '<a class="sr-thumb" href="/blog/' + p.slug + '"><img src="' + p.cover + '" alt="" loading="lazy"></a>'
            : '';
          return (
            '<article class="card sr-card">' +
            '<div class="sr-body">' +
            '<h2 class="sr-title"><a href="/blog/' + p.slug + '">' + highlight(p.title, words) + '</a></h2>' +
            '<p class="sr-excerpt">' + highlight(excerptOf(p, words), words) + '</p>' +
            '<div class="sr-meta"><span>' + p.date + '</span><span class="sep">·</span><span>' + p.views + ' 阅读</span>' +
            '<span class="sr-tags">' + tags + '</span></div>' +
            '</div>' + cover +
            '</article>'
          );
        })
        .join('');
    };

    let timer = null;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const q = input.value;
        const url = new URL(location.href);
        if (q.trim()) url.searchParams.set('q', q);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
        search(q);
      }, 180);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      input.focus();
      search('');
    });

    document.querySelectorAll('.hot-tag').forEach((btn) =>
      btn.addEventListener('click', () => {
        input.value = btn.dataset.q;
        search(btn.dataset.q);
        input.focus();
      })
    );

    const initial = new URL(location.href).searchParams.get('q') || '';
    if (initial) {
      input.value = initial;
      search(initial);
    } else {
      input.focus();
    }
  })();
</script>

<style>
  .search-panel {
    padding: 22px 24px;
    margin-top: 4px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 58px;
    padding: 0 18px;
    border-radius: 14px;
    background: var(--card-soft);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-box:focus-within {
    border-color: rgba(246, 161, 28, 0.55);
    box-shadow: 0 12px 28px -14px rgba(232, 137, 11, 0.5);
    background: var(--card);
  }

  .search-icon {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--text-3);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .search-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    color: var(--text-1);
  }

  .search-input::placeholder {
    color: var(--text-3);
  }

  .search-clear {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--text-3);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .search-clear:hover {
    color: var(--text-1);
    background: var(--border);
  }

  .search-clear svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .search-hot {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .hot-label {
    flex: none;
    font-size: 12.5px;
    color: var(--text-3);
  }

  .hot-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hot-tag {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 13px;
    font-weight: 600;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .hot-tag:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }

  .search-meta {
    margin: 20px 4px 0;
    font-size: 14px;
    color: var(--text-2);
  }

  .search-meta :global(b) {
    color: var(--accent-strong);
  }

  .search-results {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 16px;
  }

  /* 结果卡片是运行时 innerHTML 注入的，必须用 :global 才能命中 */
  :global(.sr-card) {
    display: flex;
    gap: 20px;
    padding: 22px;
  }

  :global(.sr-body) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  :global(.sr-title) {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.5;
  }

  :global(.sr-title a) {
    color: var(--text-1);
  }

  :global(.sr-title a:hover) {
    color: var(--accent-strong);
  }

  :global(mark) {
    background: linear-gradient(180deg, transparent 55%, rgba(246, 161, 28, 0.45) 55%);
    color: inherit;
    padding: 0 1px;
    border-radius: 2px;
  }

  :global(.sr-excerpt) {
    margin: 10px 0 0;
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.sr-meta) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
    font-size: 12.5px;
    color: var(--text-3);
    flex-wrap: wrap;
  }

  :global(.sr-tags) {
    display: flex;
    gap: 10px;
    margin-left: auto;
  }

  :global(.sr-tag) {
    color: var(--accent-strong);
    font-weight: 600;
  }

  :global(.sr-thumb) {
    flex: none;
    width: 150px;
    min-height: 110px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--card-soft);
  }

  :global(.sr-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  :global(.sr-thumb:hover img) {
    transform: scale(1.06);
  }

  .search-empty {
    margin-top: 20px;
    padding: 54px 24px;
    text-align: center;
  }

  .empty-icon {
    width: 46px;
    height: 46px;
    color: var(--text-3);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.7;
  }

  .search-empty h2 {
    margin: 16px 0 8px;
    font-size: 18px;
    color: var(--text-1);
  }

  .search-empty p {
    margin: 0;
    font-size: 13.5px;
    color: var(--text-3);
  }

  .search-intro {
    margin: 22px 4px 0;
    font-size: 13.5px;
    color: var(--text-3);
  }

  @media (max-width: 640px) {
    :global(.sr-card) {
      flex-direction: column-reverse;
      padding: 18px;
    }

    :global(.sr-thumb) {
      width: 100%;
      min-height: 150px;
    }

    :global(.sr-tags) {
      margin-left: 0;
    }
  }
</style>
