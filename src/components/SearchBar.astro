---
interface Props {
  placeholder?: string;
}

const { placeholder = '搜寻标题、描述或标签…' } = Astro.props;
---

<div class="search-wrap">
  <form class="search" role="search" action="/search" method="get">
    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.4-3.4"></path>
    </svg>
    <input
      class="search-input"
      type="search"
      name="q"
      placeholder={placeholder}
      aria-label="搜索文章"
    />
  </form>
</div>

<style>
  .search-wrap {
    position: relative;
    z-index: 6;
    display: flex;
    justify-content: center;
    margin-top: -38px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 14px;
    width: min(100%, 860px);
    height: 72px;
    padding: 0 28px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
  }

  .search-icon {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--text-3);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .search-input {
    flex: 1;
    height: 100%;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-size: 17px;
    color: var(--text-1);
  }

  .search-input::placeholder {
    color: var(--text-3);
  }

  .search:focus-within {
    border-color: rgba(246, 161, 28, 0.55);
    box-shadow: 0 18px 40px -18px rgba(232, 137, 11, 0.45);
  }

  @media (max-width: 640px) {
    .search {
      height: 60px;
      padding: 0 20px;
    }

    .search-input {
      font-size: 15px;
    }
  }
</style>
