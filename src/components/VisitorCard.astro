---
---

<section class="card visitor-card">
  <div class="visitor-head">
    <span class="visitor-head-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3.2c-4.1 0-7.4 3.3-7.4 7.4 0 4.6 5.1 8.9 6.7 10.1a1.1 1.1 0 0 0 1.4 0c1.6-1.2 6.7-5.5 6.7-10.1 0-4.1-3.3-7.4-7.4-7.4Z"></path>
        <circle cx="12" cy="10.4" r="2.6"></circle>
      </svg>
    </span>
    <h2 class="card-title">访客信息</h2>
  </div>

  <div class="visitor-hero" id="visitorHero">
    <span class="visitor-icon">
      <svg class="ic-desktop" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="12" rx="2.5"></rect>
        <path d="M8.5 20h7"></path>
        <path d="M12 16v4"></path>
      </svg>
      <svg class="ic-mobile" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="7" y="3" width="10" height="18" rx="2.6"></rect>
        <path d="M11 18h2"></path>
      </svg>
    </span>
    <span class="visitor-hero-text">
      <strong class="visitor-os" id="visitorOs">正在识别…</strong>
      <span class="visitor-pill" id="visitorType">—</span>
    </span>
  </div>

  <ul class="visitor-list">
    <li><span class="k">浏览器</span><span class="v" id="visitorBrowser">—</span></li>
    <li><span class="k">屏幕分辨率</span><span class="v" id="visitorScreen">—</span></li>
    <li><span class="k">界面语言</span><span class="v" id="visitorLang">—</span></li>
    <li><span class="k">时区</span><span class="v" id="visitorTz">—</span></li>
    <li><span class="k">IP 地址</span><span class="v mono" id="visitorIp">获取中…</span></li>
  </ul>
</section>

<style>
  .visitor-card {
    padding: 22px 20px;
  }

  .visitor-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .visitor-head-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    background: linear-gradient(150deg, var(--accent), #ffca63);
    color: #fff;
    box-shadow: 0 6px 14px -8px rgba(246, 161, 28, 0.9);
  }

  .visitor-head-icon svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card-title {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--text-1);
  }

  .visitor-hero {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 16px;
    border-radius: var(--radius-sm);
    background: var(--card-soft);
    border: 1px solid var(--border);
  }

  .visitor-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--accent-strong);
  }

  .visitor-icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .visitor-icon .ic-mobile {
    display: none;
  }

  .visitor-hero.is-mobile .ic-desktop {
    display: none;
  }

  .visitor-hero.is-mobile .ic-mobile {
    display: block;
  }

  .visitor-hero-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .visitor-os {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-1);
  }

  .visitor-pill {
    align-self: flex-start;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  .visitor-list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }

  .visitor-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 2px;
    font-size: 13.5px;
    border-bottom: 1px dashed var(--border);
  }

  .visitor-list li:last-child {
    border-bottom: none;
    padding-bottom: 2px;
  }

  .visitor-list .k {
    color: var(--text-2);
  }

  .visitor-list .v {
    color: var(--text-1);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .visitor-list .v.mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 600;
    font-size: 12.5px;
  }
</style>

<script>
  import { getGeo } from '../scripts/geo';

  const ua = navigator.userAgent;
  const uaData = (navigator as any).userAgentData;

  function detectOS(): string {
    const platform = String(uaData?.platform || '').toLowerCase();
    if (platform.includes('windows')) return 'Windows';
    if (platform.includes('mac')) return 'macOS';
    if (platform.includes('chrome os')) return 'ChromeOS';
    if (platform.includes('android')) return 'Android';
    if (platform.includes('ios')) return 'iOS';
    if (platform.includes('linux')) return 'Linux';

    if (/Windows NT 10/.test(ua)) return 'Windows 10/11';
    if (/Windows NT/.test(ua)) return 'Windows';
    if (/Mac OS X/.test(ua)) return 'macOS';
    if (/Android/.test(ua)) return 'Android';
    if (/(iPhone|iPad|iPod)/.test(ua)) return 'iOS';
    if (/CrOS/.test(ua)) return 'ChromeOS';
    if (/Linux/.test(ua)) return 'Linux';
    return '未知系统';
  }

  function detectBrowser(): string {
    if (/Edg\//.test(ua)) return 'Edge ' + (ua.match(/Edg\/(\d+)/)?.[1] ?? '');
    if (/OPR\//.test(ua) || /Opera/.test(ua)) return 'Opera ' + (ua.match(/OPR\/(\d+)/)?.[1] ?? '');
    if (/Firefox\//.test(ua)) return 'Firefox ' + (ua.match(/Firefox\/(\d+)/)?.[1] ?? '');
    if (/Chrome\//.test(ua)) return 'Chrome ' + (ua.match(/Chrome\/(\d+)/)?.[1] ?? '');
    if (/Safari\//.test(ua)) return 'Safari ' + (ua.match(/Version\/(\d+)/)?.[1] ?? '');
    return '未知浏览器';
  }

  const set = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  };

  const isMobile = uaData ? !!uaData.mobile : /Mobi|Android|iPhone|iPad|iPod/i.test(ua);

  set('visitorOs', detectOS());
  set('visitorType', isMobile ? '移动端 Mobile' : '桌面端 Desktop');
  set('visitorBrowser', detectBrowser().trim());
  const screenW = screen.width || window.innerWidth || 0;
  const screenH = screen.height || window.innerHeight || 0;
  set('visitorScreen', screenW && screenH ? `${screenW} × ${screenH}` : '未知');
  set('visitorLang', navigator.language || '未知');
  set('visitorTz', Intl.DateTimeFormat().resolvedOptions().timeZone || '未知');

  const hero = document.getElementById('visitorHero');
  if (hero && isMobile) hero.classList.add('is-mobile');

  getGeo()
    .then((geo) => set('visitorIp', geo.ip))
    .catch(() => set('visitorIp', '获取失败'));
</script>
