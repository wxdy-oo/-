---
const navItems = [
  { label: '归档', href: '/archive', icon: 'archive' },
  { label: '说说', href: '/shuoshuo', icon: 'chat' },
  { label: '照片墙', href: '/photos', icon: 'image' },
  { label: '开源项目', href: '/projects', icon: 'code' },
  { label: '友链', href: '/links', icon: 'link' },
  { label: '关于', href: '/about', icon: 'info' },
];

const icons: Record<string, string> = {
  archive: '<path d="M4 7.5h16v2.5H4z"/><path d="M6 10v9h12v-9"/><path d="M10 13.5h4"/>',
  chat: '<path d="M20.5 11.8a7.7 7.7 0 0 1-11.2 7L4 20.5l1.7-5.2a7.7 7.7 0 1 1 14.8-3.5Z"/>',
  image: '<rect x="3" y="4.5" width="18" height="15" rx="3"/><circle cx="9" cy="10" r="1.6"/><path d="m5.5 17.5 4-4 3 3 3-3 4 4"/>',
  code: '<path d="m9.5 8-4 4 4 4"/><path d="m14.5 8 4 4-4 4"/>',
  link: '<path d="M9.8 14.2 14.2 9.8"/><path d="M10.8 6.9l1-1a3.4 3.4 0 0 1 4.8 4.8l-1 1"/><path d="M13.2 17.1l-1 1a3.4 3.4 0 0 1-4.8-4.8l1-1"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.2"/><circle cx="12" cy="7.8" r="0.95" fill="currentColor" stroke="none"/>',
};
---

<section class="card nav-card">
  <h2 class="card-title">导航</h2>

  <ul class="nav-list">
    {
      navItems.map((it) => (
        <li>
          <a class="nav-item" href={it.href}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[it.icon]} />
            <span>{it.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .nav-card {
    padding: 22px 20px;
  }

  .card-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 700;
    color: var(--text-1);
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 10px;
    color: var(--text-2);
    font-size: 14.5px;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .nav-item:hover {
    color: var(--accent-strong);
    background: var(--card-soft);
    transform: translateX(3px);
  }

  .nav-item svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
