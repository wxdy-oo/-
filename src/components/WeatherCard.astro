---
---

<section class="card weather-card">
  <div class="weather-head">
    <span class="weather-loc">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3.2c-4.1 0-7.4 3.3-7.4 7.4 0 4.6 5.1 8.9 6.7 10.1a1.1 1.1 0 0 0 1.4 0c1.6-1.2 6.7-5.5 6.7-10.1 0-4.1-3.3-7.4-7.4-7.4Z"></path>
        <circle cx="12" cy="10.4" r="2.6"></circle>
      </svg>
      <span id="wxCity">定位中…</span>
    </span>
    <button class="weather-acc" id="wxAcc" type="button">
      IP 定位
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"></path></svg>
    </button>
  </div>

  <div class="weather-now">
    <div class="weather-temp">
      <span id="wxTemp">--</span><span class="deg">°</span>
    </div>
    <span class="weather-icon" id="wxIconBig"></span>
  </div>

  <p class="weather-text" id="wxText">正在获取天气…</p>
  <p class="weather-range" id="wxRange">最高 --° · 最低 --°</p>

  <div class="weather-divider"></div>
  <p class="weather-label">逐小时预报</p>
  <div class="weather-hours" id="wxHours"></div>

  <div class="weather-stats">
    <div class="wx-stat">
      <span class="wx-stat-label">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3.5a3 3 0 0 0-3 3v7a4.2 4.2 0 1 0 6 0v-7a3 3 0 0 0-3-3Z"></path>
          <path d="M12 9.5v6"></path>
        </svg>
        体感
      </span>
      <strong class="wx-stat-value" id="wxFeels">--°</strong>
    </div>
    <div class="wx-stat">
      <span class="wx-stat-label">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3.6S6.4 9.9 6.4 14a5.6 5.6 0 0 0 11.2 0c0-4.1-5.6-10.4-5.6-10.4Z"></path>
        </svg>
        湿度
      </span>
      <strong class="wx-stat-value" id="wxHumidity">--%</strong>
    </div>
    <div class="wx-stat">
      <span class="wx-stat-label">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 8h11a2.5 2.5 0 1 0-2.5-2.5"></path>
          <path d="M3 12h15a2.5 2.5 0 1 1-2.5 2.5"></path>
          <path d="M3 16h9a2.5 2.5 0 1 1-2.5 2.5"></path>
        </svg>
        风速
      </span>
      <strong class="wx-stat-value" id="wxWind">--</strong>
    </div>
  </div>
</section>

<style>
  .weather-card {
    padding: 24px 22px;
  }

  .weather-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .weather-loc {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-1);
  }

  .weather-loc svg {
    flex: none;
    width: 17px;
    height: 17px;
    color: var(--accent-strong);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .weather-acc {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 4px 8px;
    border-radius: 8px;
    color: var(--text-3);
    font-size: 12px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .weather-acc:hover {
    color: var(--accent-strong);
    background: var(--card-soft);
  }

  .weather-acc svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .weather-now {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
  }

  .weather-temp {
    display: flex;
    align-items: flex-start;
    color: var(--text-1);
    font-size: 50px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .weather-temp .deg {
    margin-left: 1px;
    font-size: 22px;
    font-weight: 600;
    color: var(--text-2);
    transform: translateY(4px);
  }

  .weather-icon {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 22px;
    background: linear-gradient(150deg, var(--accent-soft), rgba(255, 255, 255, 0.6));
    color: var(--accent-strong);
  }

  :global([data-theme='dark']) .weather-icon {
    background: linear-gradient(150deg, rgba(51, 41, 26, 0.9), rgba(255, 255, 255, 0.03));
  }

  .weather-icon svg {
    width: 46px;
    height: 46px;
  }

  .weather-text {
    margin: 14px 0 0;
    color: var(--text-1);
    font-size: 15px;
    font-weight: 600;
  }

  .weather-range {
    margin: 3px 0 0;
    color: var(--text-2);
    font-size: 13px;
  }

  .weather-divider {
    margin: 18px 0 14px;
    border-top: 1px dashed var(--border);
  }

  .weather-label {
    margin: 0 0 12px;
    color: var(--text-2);
    font-size: 12.5px;
  }

  .weather-hours {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }

  .wx-hour {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .wx-hour-time {
    color: var(--text-2);
    font-size: 12px;
  }

  .wx-hour-icon {
    display: grid;
    place-items: center;
    height: 26px;
    color: var(--text-2);
  }

  .wx-hour-icon svg {
    width: 24px;
    height: 24px;
  }

  .wx-hour-temp {
    color: var(--text-1);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .weather-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px dashed var(--border);
  }

  .wx-stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0 10px;
  }

  .wx-stat:not(:first-child) {
    border-left: 1px dashed var(--border);
  }

  .wx-stat-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-2);
    font-size: 12px;
  }

  .wx-stat-label svg {
    width: 14px;
    height: 14px;
    color: var(--text-3);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wx-stat-value {
    color: var(--text-1);
    font-size: 16px;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { getGeo, reverseCity } from '../scripts/geo';

  const ICONS: Record<string, string> = {
    sun: '<circle cx="12" cy="12" r="4.1"/><path d="M12 2.6v2.1M12 19.3v2.1M5.1 5.1l1.5 1.5M17.4 17.4l1.5 1.5M2.6 12h2.1M19.3 12h2.1M5.1 18.9l1.5-1.5M17.4 6.6l1.5-1.5"/>',
    'sun-cloud':
      '<circle cx="8.8" cy="8" r="2.4"/><path d="M8.8 3.6v1.3M4.5 8h1.3M5.3 4.5l.9.9M12.3 4.5l-.9.9"/><path d="M10.6 19.4h6.7a3.4 3.4 0 0 0 .3-6.8 4.7 4.7 0 0 0-9.1-1.1 3.8 3.8 0 0 0 2.1 7.9Z"/>',
    moon: '<path d="M20.4 13.6A7.6 7.6 0 1 1 11.8 3.4a5.9 5.9 0 0 0 8.6 10.2Z"/>',
    'moon-cloud':
      '<path d="M12.3 9.1A3.6 3.6 0 1 1 8.6 4.6a2.9 2.9 0 0 0 3.7 4.5Z"/><path d="M10.6 19.4h6.7a3.4 3.4 0 0 0 .3-6.8 4.7 4.7 0 0 0-9.1-1.1 3.8 3.8 0 0 0 2.1 7.9Z"/>',
    cloud: '<path d="M7.2 18h9.3a3.6 3.6 0 0 0 .3-7.2 5.1 5.1 0 0 0-9.8-1.2A4 4 0 0 0 7.2 18Z"/>',
    fog: '<path d="M5.5 10.5h13M4.5 14h15M6.5 17.5h11"/>',
    drizzle:
      '<path d="M7.2 15.6h9.3a3.6 3.6 0 0 0 .3-7.2 5.1 5.1 0 0 0-9.8-1.2A4 4 0 0 0 7.2 15.6Z"/><path d="M9.4 18.6v1.2M13 19.2v1.2M16.6 18.6v1.2"/>',
    rain: '<path d="M7.2 15.6h9.3a3.6 3.6 0 0 0 .3-7.2 5.1 5.1 0 0 0-9.8-1.2A4 4 0 0 0 7.2 15.6Z"/><path d="M9.2 18.4l-.9 2.2M13 18.4l-.9 2.2M16.8 18.4l-.9 2.2"/>',
    snow: '<path d="M7.2 15.6h9.3a3.6 3.6 0 0 0 .3-7.2 5.1 5.1 0 0 0-9.8-1.2A4 4 0 0 0 7.2 15.6Z"/><path d="M9.6 18.8h.01M12.8 20.2h.01M15.9 18.8h.01"/>',
    thunder:
      '<path d="M7.2 14.8h9.3a3.6 3.6 0 0 0 .3-7.2 5.1 5.1 0 0 0-9.8-1.2A4 4 0 0 0 7.2 14.8Z"/><path d="M12.7 15.8l-2.1 3.6h2.8l-1.4 3.4"/>',
  };

  function svg(name: string, size: number): string {
    const body = ICONS[name] || ICONS.cloud;
    return `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
  }

  /** WMO 天气代码 → 中文描述与图标（isDay 决定晴天/多云用太阳还是月亮） */
  function weatherInfo(code: number, isDay = true): { text: string; icon: string } {
    if (code === 0) return { text: '晴', icon: isDay ? 'sun' : 'moon' };
    if (code === 1) return { text: '大部晴朗', icon: isDay ? 'sun-cloud' : 'moon-cloud' };
    if (code === 2) return { text: '局部多云', icon: isDay ? 'sun-cloud' : 'moon-cloud' };
    if (code === 3) return { text: '阴天', icon: 'cloud' };
    if (code === 45 || code === 48) return { text: '雾', icon: 'fog' };
    if ([51, 53, 55, 56, 57].includes(code)) return { text: '毛毛雨', icon: 'drizzle' };
    if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return { text: '雨', icon: 'rain' };
    if ([71, 73, 75, 77, 85, 86].includes(code)) return { text: '雪', icon: 'snow' };
    if ([95, 96, 99].includes(code)) return { text: '雷暴', icon: 'thunder' };
    return { text: '未知', icon: 'cloud' };
  }

  const $ = (id: string) => document.getElementById(id);
  const set = (id: string, text: string) => {
    const el = $(id);
    if (el) el.textContent = text;
  };

  async function load(lat: number, lng: number) {
    const url =
      `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}` +
      '&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,wind_speed_10m' +
      '&hourly=temperature_2m,weather_code,is_day' +
      '&daily=temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=1';

    const data = await (await fetch(url)).json();
    const cur = data.current;
    const info = weatherInfo(cur.weather_code, cur.is_day === 1);

    set('wxTemp', String(Math.round(cur.temperature_2m)));
    set('wxText', info.text);
    set('wxRange', `最高 ${Math.round(data.daily.temperature_2m_max[0])}° · 最低 ${Math.round(data.daily.temperature_2m_min[0])}°`);
    set('wxFeels', `${Math.round(cur.apparent_temperature)}°`);
    set('wxHumidity', `${Math.round(cur.relative_humidity_2m)}%`);
    set('wxWind', `${Math.round(cur.wind_speed_10m)} km/h`);

    const bigIcon = $('wxIconBig');
    if (bigIcon) bigIcon.innerHTML = svg(info.icon, 46);

    // 从当前整点起取 4 段逐小时数据
    const times: string[] = data.hourly.time;
    const hourKey = String(cur.time).slice(0, 13);
    let start = times.findIndex((t) => t.slice(0, 13) === hourKey);
    if (start < 0) start = 0;

    const hoursEl = $('wxHours');
    if (hoursEl) {
      let html = '';
      for (let i = start; i < Math.min(start + 4, times.length); i++) {
        const hi = weatherInfo(data.hourly.weather_code[i], data.hourly.is_day?.[i] === 1);
        const label = i === start ? '现在' : `${Number(times[i].slice(11, 13))}时`;
        html +=
          '<div class="wx-hour">' +
          `<span class="wx-hour-time">${label}</span>` +
          `<span class="wx-hour-icon">${svg(hi.icon, 24)}</span>` +
          `<strong class="wx-hour-temp">${Math.round(data.hourly.temperature_2m[i])}°</strong>` +
          '</div>';
      }
      hoursEl.innerHTML = html;
    }
  }

  async function init() {
    try {
      const geo = await getGeo();
      set('wxCity', geo.city || geo.region || '未知位置');
      await load(geo.lat, geo.lng);
    } catch {
      set('wxCity', '未知位置');
      set('wxText', '天气获取失败');
    }
  }

  // 点击「精确度」使用浏览器定位，获得更高精度
  const acc = $('wxAcc');
  acc?.addEventListener('click', () => {
    if (!navigator.geolocation) return;
    acc.textContent = '定位中…';
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        acc.textContent = '精确定位';
        try {
          const name = await reverseCity(pos.coords.latitude, pos.coords.longitude);
          if (name.city) set('wxCity', name.city);
        } catch {
          /* 城市名获取失败不影响天气 */
        }
        load(pos.coords.latitude, pos.coords.longitude).catch(() => set('wxText', '天气获取失败'));
      },
      () => {
        acc.textContent = 'IP 定位';
      }
    );
  });

  init();
</script>
