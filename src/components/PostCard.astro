---
interface Props {
  variant?: 'featured' | 'compact';
  title?: string;
  description?: string;
  date?: string;
  views?: number;
  tags?: string[];
  image?: string;
  href?: string;
}

const {
  variant = 'featured',
  title = '从被动检索到主动导航：NapMem 让大模型学会“使用记忆”',
  description = '论文阅读笔记：将记忆转化成智能体可以学习使用的结构化动作空间',
  date = '2026.07.11',
  views = 11,
  tags = ['Agent Memory', 'RL'],
  image = '/images/post-thumb.jpg',
  href = '#',
} = Astro.props;
---

<article class:list={['card', 'post-card', variant]}>
  {
    variant === 'compact' && (
      <a class="post-thumb" href={href} aria-label={title}>
        <img src={image} alt="" />
      </a>
    )
  }

  <div class="post-body">
    <h2 class="post-title">
      <a href={href}>{title}</a>
    </h2>
    <p class="post-desc">{description}</p>

    <div class="post-meta">
      <div class="post-info">
        <span>{date}</span>
        <span class="sep">·</span>
        <span class="post-views">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          {views}
        </span>
      </div>

      <div class="post-tags">
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
  </div>

  {
    variant === 'featured' && (
      <a class="post-thumb" href={href} aria-label={title}>
        <img src={image} alt="" />
      </a>
    )
  }
</article>

<style>
  .post-card {
    display: flex;
    gap: 22px;
    padding: 26px;
  }

  .post-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .post-title {
    margin: 0;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text-1);
  }

  .post-title a:hover {
    color: var(--accent-strong);
  }

  .post-desc {
    margin: 14px 0 0;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.7;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px dashed var(--border);
    font-size: 13px;
    color: var(--text-2);
  }

  .post-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sep {
    color: var(--text-3);
  }

  .post-views {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .post-views svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .post-tags {
    display: flex;
    gap: 16px;
    color: var(--accent-strong);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  .post-tags .tag:hover {
    text-decoration: underline;
  }

  .post-thumb {
    flex: none;
    width: 200px;
    overflow: hidden;
    border-radius: 14px;
    background: var(--card-soft);
    align-self: stretch;
  }

  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .post-thumb:hover img {
    transform: scale(1.06);
  }

  /* 精选：图片在右，较大 */
  .featured .post-thumb {
    min-height: 180px;
  }

  /* 紧凑：图片在左，整体更小 */
  .compact {
    gap: 18px;
    padding: 18px;
  }

  .compact .post-title {
    font-size: 18px;
    line-height: 1.5;
  }

  .compact .post-desc {
    margin-top: 10px;
    font-size: 13.5px;
  }

  .compact .post-thumb {
    width: 190px;
    min-height: 132px;
    border-radius: 12px;
  }

  .compact .post-meta {
    padding-top: 13px;
  }

  @media (max-width: 760px) {
    .post-card {
      flex-direction: column-reverse;
    }

    .post-thumb,
    .compact .post-thumb {
      width: 100%;
      min-height: 180px;
    }

    .compact .post-title {
      font-size: 17px;
    }
  }
</style>
